# PostgreSQL / Neon
LOCAL_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=postgresql://usuario:password@host/base?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# HTTP
PORT=4000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Account activation email (production should use a real SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_USER=
SMTP_AUTH_PASS=
SMTP_FROM=no-reply@cecyte.edu.mx

# Optional audit E2E test (use a dedicated non-admin target user)
E2E_API_URL=http://localhost:4000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TARGET_USER_ID=

# Cloudflare R2 / S3-compatible storage (needed for horario uploads/backups)
AWS_REGION=auto
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
