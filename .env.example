# ══════════════════════════════════════════════════════════════════════════════
# PLATAFORMA CECyTE Plantel 1 — PLANTILLA DE ENTORNO (.env.example)
# Copiar a .env y completar los valores. Nunca commitear el .env real.
# ══════════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# En producción, el dominio real del frontend (el frontend se sirve estático).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ── Base de datos (PostgreSQL / Neon) ────────────────────────────────────────
# ej: postgresql://usuario:contrasena@host:5432/nombre_db
DATABASE_URL=

# ── JWT / autenticación ──────────────────────────────────────────────────────
JWT_SECRET=<generar una frase aleatoria de >32 caracteres>
JWT_EXPIRES_IN=7d

# ── AWS S3 / Cloudflare R2 ───────────────────────────────────────────────────
# Para S3 puro: AWS_ENDPOINT no se usa.
# Para MinIO/R2 local: AWS_ENDPOINT=http://localhost:9000 y forcePathStyle=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_ENDPOINT=
AWS_BUCKET_NAME=

# ── Redis — fases 0/1 (cache, colas BullMQ, contadores) ─────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Mailpit — SMTP de desarrollo + UI para inspeccionar correos ──────────────
# Corre con: docker compose up mailpit   (ver docker-compose.yml)
MAILPIT_BOX_DEFAULT_NAME=cecyte
MAILPIT_SMTP_PORT=1025
MAILPIT_API_PORT=8025
MAILPIT_MAIL_DIR=./data/mailpit

# ── SMTP de producción (envió real de correos: confirmación, recordatorios) ──
# SMTP_HOST=smtp.sendgrid.net   (pasar a la que use: SendGrid/Resend/Mailgun)
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM="CECyTE Plantel 1 <no-reply@cecyte.edu.mx>"
# SMTP_AUTH_USER=
# SMTP_AUTH_PASS=

# ── Respaldos automáticos (cron) ─────────────────────────────────────────────
# Formato crontab: MINUTO HORA DIAMENES MES DOW
# 0 3 * * * = 03:00 hora México cada día
BACKUP_TIME="0 3 * * *"

# ── Frontend (Vite, solo desarrollo) ─────────────────────────────────────────
# Proxy de Vite: /api → backend. En producción el frontend apila a /api relativo.
VITE_API_PROXY_TARGET=http://localhost:4000

# ── AI/LLM (opcional, no afecta el backend) ──────────────────────────────────
# DEEPSEEK_USE_LOCAL=true
# DEEPSEEK_MODEL=deepseek-coder:6.7b
# OLLAMA_HOST=http://localhost:11434